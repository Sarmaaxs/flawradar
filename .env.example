# Copy to .env and edit. Real environment variables override this file.

PORT=3000
HOST=127.0.0.1

# Public address of the site, used in the user agent string and links.
FLAWRADAR_BASE_URL=https://flawradar.pro.et

# The address(es) scans leave from. Comma separated, IPv4 and IPv6.
# These are what people allow-list, so they must be true.
FLAWRADAR_PUBLIC_IPS=203.0.113.10

# Optional: bind outgoing connections to this local address. Use it when the
# machine has several addresses and only one is published.
FLAWRADAR_EGRESS_IP=

# Shown on the Whitelist page for abuse reports.
FLAWRADAR_CONTACT=abuse@flawradar.pro.et

# Set to 1 only when running behind a reverse proxy you control.
# Otherwise people can fake their address and dodge the rate limit.
FLAWRADAR_TRUST_PROXY=0

# Limits
FLAWRADAR_SCANS_PER_HOUR=12
FLAWRADAR_SCANS_PER_HOST_PER_HOUR=6
# Higher limit for hosts that publish a flawradar-allow DNS/file record.
FLAWRADAR_SCANS_PER_HOST_ALLOWED_PER_HOUR=30
FLAWRADAR_MAX_CONCURRENT=4
FLAWRADAR_RETENTION_DAYS=30

# Where the SQLite file lives.
FLAWRADAR_DATA_DIR=./data

# Development only. Allows scanning private addresses and custom ports.
# Never set this on a public instance.
# FLAWRADAR_ALLOW_PRIVATE=1
