# Copy to .env and edit. Real environment variables override this file.

PORT=3000
HOST=127.0.0.1

# Public address of the site, used in the user agent string and links.
FLAWRADAR_BASE_URL=https://flawradar.pro.et

# The address(es) scans leave from. Comma separated, IPv4 and IPv6.
# These are what people allow-list, so they must be true. Leave blank until
# you have verified the real outbound addresses externally.
FLAWRADAR_PUBLIC_IPS=

# Optional: bind outgoing connections to this local address. Use it when the
# machine has several addresses and only one is published. Must be an IP
# actually assigned to a local interface (not a NAT public address).
FLAWRADAR_EGRESS_IP=

# Shown on the Whitelist page for abuse reports.
FLAWRADAR_CONTACT=saremisback@gmail.com

# Set to 1 only when running behind a reverse proxy you control.
# Otherwise people can fake their address and dodge the rate limit.
FLAWRADAR_TRUST_PROXY=0

# Limits
FLAWRADAR_SCANS_PER_HOUR=12
FLAWRADAR_SCANS_PER_HOST_PER_HOUR=6
# Higher limit for hosts that publish a flawradar-allow DNS/file record.
FLAWRADAR_SCANS_PER_HOST_ALLOWED_PER_HOUR=30
FLAWRADAR_MAX_CONCURRENT=4
FLAWRADAR_RETENTION_DAYS=30

# Source code checks per visitor per hour (the API; the page itself runs in the browser).
FLAWRADAR_SOURCE_PER_HOUR=20

# Hosts whose owners asked not to be scanned. Also covers their subdomains.
# FLAWRADAR_BLOCKED_HOSTS=example.org,another.example

# Filled into the Terms, Acceptable Use and Privacy pages. Empty ones show as
# yellow placeholders. Have a lawyer read the pages before you launch.
FLAWRADAR_LEGAL_ENTITY=Sarem Menur
FLAWRADAR_LEGAL_EMAIL=saremisback@gmail.com
FLAWRADAR_LEGAL_LAW=the laws of the Federal Democratic Republic of Ethiopia
FLAWRADAR_LEGAL_HOSTING=the hosting and email service providers selected by the Operator; provider and processing region may change
FLAWRADAR_LEGAL_LOG_RETENTION=Scan reports are retained for the period stated in the Privacy Policy.

# Watches: scheduled rescans of hosts whose owner proved control, with an email
# when the grade drops. Switched on by setting an SMTP server. Port 465 uses TLS,
# port 587 uses STARTTLS.
# FLAWRADAR_SMTP_HOST=smtp.example.com
# FLAWRADAR_SMTP_PORT=587
# FLAWRADAR_SMTP_USER=
# FLAWRADAR_SMTP_PASS=
# FLAWRADAR_SMTP_FROM=alerts@flawradar.pro.et
FLAWRADAR_WATCH_INTERVAL_HOURS=24
FLAWRADAR_MAX_WATCHES_PER_EMAIL=5
FLAWRADAR_WATCH_SIGNUPS_PER_HOUR=6

# Automatic copies of the database. Empty = off. Keep the newest N.
# FLAWRADAR_BACKUP_DIR=./backups
FLAWRADAR_BACKUP_KEEP=7
FLAWRADAR_BACKUP_INTERVAL_HOURS=24

# Where the SQLite file lives.
FLAWRADAR_DATA_DIR=./data

# Development only. Allows scanning private addresses and custom ports.
# Never set this on a public instance.
# FLAWRADAR_ALLOW_PRIVATE=1
